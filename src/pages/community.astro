---
// Layout
import PublicLayout from "@/layouts/PublicLayout.astro";

// Components
import CommunityFeed from "@/components/feed/CommunityFeed";

// Library
import { listPosts } from "@/lib/db/posts";
import { DEFAULT_LIMIT, nextOffset } from "@/lib/posts/pagination";
import type { FeedPost } from "@/lib/posts/types";

let posts: FeedPost[] = [];
try {
  const rows = await listPosts({ offset: 0, limit: DEFAULT_LIMIT });
  posts = rows.map((row) => ({ ...row, createdAt: row.createdAt.toISOString() }));
} catch {
  posts = [];
}
const next = nextOffset(0, DEFAULT_LIMIT, posts.length);
---

<PublicLayout>
  <main class="flex flex-col gap-4 px-6 pt-32 pb-16 md:px-12 md:pt-40 md:pb-24 xl:px-24">
    <h1 class="font-display text-3xl font-extrabold text-ink md:text-5xl">Community</h1>
    <p class="max-w-[65ch] text-muted-foreground">
      Questions, advice and partnerships from the Penguino community.
    </p>
    <CommunityFeed client:load initialPosts={posts} initialNextOffset={next} />
  </main>
</PublicLayout>
